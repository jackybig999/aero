# ==============================================================================
# AIsys Unified .gitignore
# ==============================================================================

# OS & Editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/

# Node.js & Web build
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Binaries & Executables (preserve required embedded wintun.dll)
*.exe
*.exe~
*.dll
!protocol/client/win/wintun.dll
*.so
*.dylib

# Logs & Runtime Temp
logs/
tmp/
*.log
*.tmp
*.temp
*.out
*.test
.host-ip-cache.json
.last-sub-body
.last-sub-url
.saved-proxy.json
.runtime-port
**/logs/
**/*.log

# Environment & Local Secrets (preserve examples)
.env
.env.*
!.env.example
!*.env.example

# Local Testing Binaries
platform.exe
**/platform.exe

# Go Test Artifacts
*.test
__debug_bin*
sub/vpn/vpn/
/dist/
/build/dist/

# SQLite WAL and SHM files
*.db-shm
*.db-wal
