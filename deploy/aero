# ----------------- 参数路由 -----------------
action="${1:-}"
case "$action" in
    status)         cmd_status ;;
    info|sub)       cmd_info ;;
    start)          cmd_start ;;
    stop)           cmd_stop ;;
    restart)        cmd_restart ;;
    reload)         cmd_reload ;;
    log|logs)       cmd_log ;;
    token|tokens)   cmd_tokens ;;
    add-token)      cmd_add_token ;;
    cert)           cmd_cert ;;
    bbr)            cmd_bbr ;;
    net|tun)        cmd_net ;;
    geodata)        cmd_geodata ;;
    warp)           cmd_warp ;;
    update)         cmd_update ;;
    uninstall)      cmd_uninstall ;;
    help|-h|--help)
        echo "用法: aero [命令]"
        echo "命令:"
        echo "  status       查看服务运行状态、TUN 与多端口"
        echo "  info, sub    查看客户端订阅链接与 Web 控制台 URL"
        echo "  start        启动服务"
        echo "  stop         停止服务"
        echo "  restart      重启服务"
        echo "  reload       平滑热重载配置与证书"
        echo "  log          查看实时运行日志"
        echo "  tokens       查看已授权 Token"
        echo "  add-token    新增用户 Token"
        echo "  cert         查看 TLS 证书与自动续期健康状态"
        echo "  bbr          查看并开启 BBR 拥塞控制"
        echo "  net          查看 TUN 网卡与防火墙 NAT 状态"
        echo "  geodata      查看并同步 GeoData 规则库"
        echo "  warp         查看 WARP 出口代理状态"
        echo "  update       更新服务端至最新版本"
        echo "  uninstall    对称卸载节点"
        echo "  (不带参数直接运行进入交互式管理菜单)"
        ;;
    *)
        show_menu
        ;;
esac
