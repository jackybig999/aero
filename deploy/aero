#!/usr/bin/env bash
# ==============================================================================
# AERO Edge — 命令行终端后台管理工具 (全功能配齐版 v1.2.36)
# 支持交互式终端菜单与非交互式快捷命令调用
# ==============================================================================
set -e

RED="\033[31m"
GREEN="\033[32m"
YELLOW="\033[33m"
BLUE="\033[34m"
CYAN="\033[36m"
PLAIN="\033[0m"
BOLD="\033[1m"

CONFIG_FILE="/etc/aero/edge.conf"
JSON_CONFIG="/etc/aero/edge.json"
DATA_DIR="/var/lib/aero"
SUB_META="$DATA_DIR/sub_meta.json"
TOKENS_FILE="$DATA_DIR/tokens.json"
CERT_FILE="$DATA_DIR/tls/fullchain.pem"
INSTALL_SCRIPT_URL="https://raw.githubusercontent.com/jackybig999/aero/main/deploy/edge-install.sh"
UNINSTALL_SCRIPT_URL="https://raw.githubusercontent.com/jackybig999/aero/main/deploy/edge-uninstall.sh"

check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}错误: 必须使用 root 用户或 sudo 执行此脚本！${PLAIN}"
        exit 1
    fi
}

load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$CONFIG_FILE"
    fi
    DOMAIN="${AERO_DOMAIN:-}"
    TOKEN="${AERO_TOKEN:-}"
    PORTS="${AERO_PORTS:-443}"
    PRIMARY_PORT=$(echo "$PORTS" | cut -d, -f1 | tr -d ' ')
    ADMIN_KEY="${AERO_ADMIN_KEY:-}"
    
    if [[ -z "$DOMAIN" && -f "$JSON_CONFIG" ]]; then
        DOMAIN=$(grep -o '"domain":[^,]*' "$JSON_CONFIG" 2>/dev/null | cut -d'"' -f4 || true)
    fi
    if [[ -z "$ADMIN_KEY" && -f "$JSON_CONFIG" ]]; then
        ADMIN_KEY=$(grep -o '"admin_key":[^,]*' "$JSON_CONFIG" 2>/dev/null | cut -d'"' -f4 || true)
    fi
    if [[ -z "$PRIMARY_PORT" && -f "$JSON_CONFIG" ]]; then
        P_STR=$(grep -o '"listen":[^,]*' "$JSON_CONFIG" 2>/dev/null | cut -d'"' -f4 || true)
        PRIMARY_PORT="${P_STR#:}"
    fi
    if [[ -z "$PRIMARY_PORT" ]]; then
        PRIMARY_PORT="443"
    fi
}

get_status() {
    if systemctl is-active --quiet aero-edge 2>/dev/null; then
        echo -e "${GREEN}运行中 (Active)${PLAIN}"
    else
        echo -e "${RED}未运行 (Stopped)${PLAIN}"
    fi
}

cmd_status() {
    load_config
    echo -e "${CYAN}====================================================${PLAIN}"
    echo -e "${BOLD}              AERO Edge 节点运行状态               ${PLAIN}"
    echo -e "${CYAN}====================================================${PLAIN}"
    echo -e " 运行状态:       $(get_status)"
    echo -e " 绑定域名:       ${GREEN}${DOMAIN:-未配置}${PLAIN}"
    echo -e " 监听主端口:     ${GREEN}:${PRIMARY_PORT}${PLAIN}"
    echo -e " 跳频备用端口池: ${YELLOW}2083, 2087, 8443, 2053, 2096, 10443, 24443, 34443, 44443 (原生全活)${PLAIN}"
    
    # 检测 TUN 状态
    if ip link show aero-tun0 >/dev/null 2>&1; then
        TUN_STATUS="${GREEN}UP (10.88.0.1/16, fd88:ae80::1/64, MTU=1360)${PLAIN}"
    else
        TUN_STATUS="${YELLOW}未激活 (服务启动时自动挂载)${PLAIN}"
    fi
    echo -e " 虚拟网卡 (TUN): ${TUN_STATUS}"

    # 检测 BBR
    BBR_STATUS="未启用"
    if [[ -f "/proc/sys/net/ipv4/tcp_congestion_control" ]]; then
        CC=$(cat /proc/sys/net/ipv4/tcp_congestion_control)
        if [[ "$CC" == "bbr" ]]; then
            BBR_STATUS="${GREEN}BBR (已开启)${PLAIN}"
        else
            BBR_STATUS="${YELLOW}${CC} (未启用 BBR)${PLAIN}"
        fi
    fi
    echo -e " 拥塞控制算法:   ${BBR_STATUS}"

    echo -e " 配置文件:       ${JSON_CONFIG}"
    echo -e " 数据目录:       ${DATA_DIR}"
    echo -e "${CYAN}----------------------------------------------------${PLAIN}"
    
    if systemctl is-active --quiet aero-edge 2>/dev/null; then
        UPTIME=$(systemctl show aero-edge --property=ActiveEnterTimestamp 2>/dev/null | cut -d= -f2 || true)
        PID=$(systemctl show aero-edge --property=MainPID 2>/dev/null | cut -d= -f2 || true)
        echo -e " 进程 PID:       ${GREEN}${PID}${PLAIN}"
        echo -e " 启动时间:       ${UPTIME}"
    fi
    echo -e "${CYAN}====================================================${PLAIN}"
}

cmd_info() {
    load_config
    echo -e "${CYAN}====================================================${PLAIN}"
    echo -e "${BOLD}            AERO Edge 订阅与接入信息               ${PLAIN}"
    echo -e "${CYAN}====================================================${PLAIN}"
    echo -e " 节点域名:       ${GREEN}${DOMAIN}${PLAIN}"
    echo -e " 监听主端口:     ${GREEN}:${PRIMARY_PORT}${PLAIN}"
    echo -e " 管理密钥:       ${YELLOW}${ADMIN_KEY:-未设置}${PLAIN}"
    echo -e "${CYAN}----------------------------------------------------${PLAIN}"
    if [[ -n "$DOMAIN" ]]; then
        ADMIN_SUB_URL="https://${DOMAIN}/sub/admin"
        CONSOLE_URL="https://${DOMAIN}:${PRIMARY_PORT}/console?key=${ADMIN_KEY}"
        
        echo -e " 管理员全量订阅: ${CYAN}${ADMIN_SUB_URL}${PLAIN} (零端口权威规范)"
        echo -e " 用户专属订阅:   ${GREEN}https://${DOMAIN}/sub/{用户名}{6位随机码}${PLAIN}"
        echo -e " Web 管理控制台: ${GREEN}${CONSOLE_URL}${PLAIN}"
    else
        echo -e "${YELLOW}提示: 节点配置未就绪，请先启动 aero-edge 服务${PLAIN}"
    fi
    echo -e "${CYAN}====================================================${PLAIN}"
}

cmd_start() {
    check_root
    echo -e "${CYAN}正在启动 aero-edge 服务...${PLAIN}"
    systemctl start aero-edge
    sleep 1
    if systemctl is-active --quiet aero-edge; then
        echo -e "${GREEN}aero-edge 启动成功！${PLAIN}"
    else
        echo -e "${RED}aero-edge 启动失败，最近日志如下：${PLAIN}"
        journalctl -u aero-edge -n 20 --no-pager
    fi
}

cmd_stop() {
    check_root
    echo -e "${YELLOW}正在停止 aero-edge 服务...${PLAIN}"
    systemctl stop aero-edge || true
    echo -e "${GREEN}aero-edge 已停止。${PLAIN}"
}

cmd_restart() {
    check_root
    echo -e "${CYAN}正在重启 aero-edge 服务...${PLAIN}"
    systemctl restart aero-edge
    sleep 1
    if systemctl is-active --quiet aero-edge; then
        echo -e "${GREEN}aero-edge 重启成功！${PLAIN}"
    else
        echo -e "${RED}aero-edge 启动失败，最近日志如下：${PLAIN}"
        journalctl -u aero-edge -n 20 --no-pager
    fi
}

cmd_reload() {
    check_root
    echo -e "${CYAN}正在平滑无损热重载配置与证书...${PLAIN}"
    systemctl reload aero-edge 2>/dev/null || systemctl restart aero-edge
    echo -e "${GREEN}aero-edge 热重载指令已发送完成！${PLAIN}"
}

cmd_log() {
    echo -e "${CYAN}正在查看实时运行日志 (按 Ctrl+C 退出)...${PLAIN}"
    journalctl -u aero-edge -f
}

cmd_tokens() {
    echo -e "${CYAN}====================================================${PLAIN}"
    echo -e "${BOLD}               已授权用户 Token 列表                ${PLAIN}"
    echo -e "${CYAN}====================================================${PLAIN}"
    if [[ -f "$TOKENS_FILE" ]]; then
        if command -v jq >/dev/null 2>&1; then
            jq -r '.[] | "Token: \(.token)\n  备注: \(.label // "默认用户")\n  到期时间: \(.expires_at // "永久")\n"' "$TOKENS_FILE" 2>/dev/null || cat "$TOKENS_FILE"
        else
            cat "$TOKENS_FILE"
        fi
    else
        echo -e "${YELLOW}暂无用户 Token 记录${PLAIN}"
    fi
    echo -e "${CYAN}====================================================${PLAIN}"
}

cmd_add_token() {
    check_root
    echo -e "${CYAN}--- 添加新用户 Token ---${PLAIN}"
    read -r -p "请输入用户备注名 (例如 user01): " label
    if [[ -z "$label" ]]; then
        label="user_$(date +%s)"
    fi
    read -r -p "请输入自定义 Token (直接回车自动生成密码学随机 Token): " new_token
    if [[ -z "$new_token" ]]; then
        new_token="aero_$(openssl rand -hex 16 2>/dev/null || head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    fi
    
    mkdir -p "$DATA_DIR"
    if [[ ! -f "$TOKENS_FILE" || ! -s "$TOKENS_FILE" ]]; then
        echo "[]" > "$TOKENS_FILE"
    fi
    
    python3 -c "
import json, sys
data = []
try:
    with open('$TOKENS_FILE', 'r') as f:
        data = json.load(f)
except Exception:
    data = []
data.append({
    'token': '$new_token',
    'label': '$label',
    'created_at': '$(date -u +"%Y-%m-%dT%H:%M:%SZ")'
})
with open('$TOKENS_FILE', 'w') as f:
    json.dump(data, f, indent=2)
" 2>/dev/null || echo -e "{\"token\": \"$new_token\", \"label\": \"$label\"}" >> "$TOKENS_FILE"

    echo -e "${GREEN}Token 添加成功！${PLAIN}"
    echo -e "备注:  ${label}"
    echo -e "Token: ${GREEN}${new_token}${PLAIN}"
    echo -e "${YELLOW}提示: 服务端支持热重载，执行 aero reload 即可生效${PLAIN}"
}

find_cert_path() {
    load_config
    if [[ -n "$DOMAIN" ]]; then
        local cand_paths=(
            "/root/.acme.sh/${DOMAIN}_ecc/fullchain.cer"
            "/root/.acme.sh/${DOMAIN}/fullchain.cer"
            "${HOME}/.acme.sh/${DOMAIN}_ecc/fullchain.cer"
            "${HOME}/.acme.sh/${DOMAIN}/fullchain.cer"
            "$CERT_FILE"
        )
        for p in "${cand_paths[@]}"; do
            if [[ -f "$p" && -s "$p" ]]; then
                echo "$p"
                return 0
            fi
        done
    fi
    # 若未指定 DOMAIN 或未找到指定证书，扫描 ACME 默认目录下的有效证书
    for d in /root/.acme.sh "${HOME}/.acme.sh"; do
        if [[ -d "$d" ]]; then
            for cert_f in "$d"/*_ecc/fullchain.cer "$d"/*/fullchain.cer; do
                if [[ -f "$cert_f" && -s "$cert_f" ]]; then
                    echo "$cert_f"
                    return 0
                fi
            done
        fi
    done
    return 1
}

cmd_cert() {
    load_config
    echo -e "${CYAN}====================================================${PLAIN}"
    echo -e "${BOLD}       TLS 公网权威证书与 ACME 自动续期管理        ${PLAIN}"
    echo -e "${CYAN}====================================================${PLAIN}"
    
    ACTUAL_CERT=$(find_cert_path || true)
    if [[ -n "$ACTUAL_CERT" ]]; then
        echo -e " 证书路径:       ${GREEN}${ACTUAL_CERT}${PLAIN}"
        CERT_SAN=$(openssl x509 -in "$ACTUAL_CERT" -noout -ext subjectAltName 2>/dev/null | grep -o 'DNS:[^, ]*' | head -1 | cut -d: -f2 || openssl x509 -in "$ACTUAL_CERT" -noout -subject 2>/dev/null | sed 's/subject= //')
        echo -e " 绑定域名 (SAN): ${GREEN}${CERT_SAN}${PLAIN}"
        echo -e " 权威签发者:     $(openssl x509 -in "$ACTUAL_CERT" -noout -issuer 2>/dev/null | sed 's/issuer= //')"
        echo -e " 生效时间:       $(openssl x509 -in "$ACTUAL_CERT" -noout -startdate 2>/dev/null | cut -d= -f2)"
        EXPIRE_DATE=$(openssl x509 -in "$ACTUAL_CERT" -noout -enddate 2>/dev/null | cut -d= -f2)
        echo -e " 到期时间:       ${GREEN}${EXPIRE_DATE}${PLAIN}"
        
        # 检查是否过期
        if openssl x509 -in "$ACTUAL_CERT" -noout -checkend 2592000 >/dev/null 2>&1; then
            echo -e " 证书有效状态:   ${GREEN}[正常] 剩余有效期充足 (> 30 天)${PLAIN}"
        elif openssl x509 -in "$ACTUAL_CERT" -noout -checkend 0 >/dev/null 2>&1; then
            echo -e " 证书有效状态:   ${YELLOW}[待续期] 剩余有效期少于 30 天，已进入续期窗口${PLAIN}"
        else
            echo -e " 证书有效状态:   ${RED}[已过期] 请立即检查 DNS 与网络并重新签发！${PLAIN}"
        fi
    else
        echo -e " 证书状态:       ${RED}未在 ACME 默认目录检测到已签发证书！${PLAIN}"
    fi

    echo -e "${CYAN}----------------------------------------------------${PLAIN}"
    # 自动续期调度检查
    if crontab -l 2>/dev/null | grep -q "acme.sh"; then
        echo -e " 自动续期机制:   ${GREEN}[正常] 系统 Cron 定时任务已挂载 (acme.sh --cron)${PLAIN}"
    else
        echo -e " 自动续期机制:   ${YELLOW}[提示] 未在系统 crontab 检测到 acme.sh 调度，由服务端内置计时器巡检${PLAIN}"
    fi
    echo -e "${CYAN}====================================================${PLAIN}"

    # 询问是否签发新证书或更新
    read -r -p "是否现在签发/更新 Let's Encrypt 公网权威证书? [y/N]: " do_issue
    if [[ ! "$do_issue" =~ ^[yY]$ ]]; then
        return 0
    fi

    check_root

    # 1. 检测系统是否安装了 acme.sh
    ACME_BIN=""
    if [[ -x "/root/.acme.sh/acme.sh" ]]; then
        ACME_BIN="/root/.acme.sh/acme.sh"
    elif [[ -x "${HOME}/.acme.sh/acme.sh" ]]; then
        ACME_BIN="${HOME}/.acme.sh/acme.sh"
    elif command -v acme.sh >/dev/null 2>&1; then
        ACME_BIN="$(command -v acme.sh)"
    fi

    if [[ -z "$ACME_BIN" ]]; then
        echo -e "${RED}[错误] 未在系统中检测到 acme.sh 证书管理工具！${PLAIN}"
        echo -e "${YELLOW}请先在终端执行以下官方命令安装 acme.sh，然后重新执行本命令：${PLAIN}"
        echo -e "  ${GREEN}curl https://get.acme.sh | sh -s email=your_email@example.com${PLAIN}"
        echo -e "  ${GREEN}source ~/.bashrc${PLAIN}"
        echo -e "安装完成后，请重新运行: ${CYAN}aero cert${PLAIN}"
        return 1
    fi

    echo -e "${GREEN}[OK] 已检测到系统 acme.sh: ${ACME_BIN}${PLAIN}"
    read -r -p "请输入节点绑定的公网合法域名 (如 edge.example.com): " req_domain
    req_domain=$(echo "$req_domain" | tr -d ' ')
    if [[ -z "$req_domain" ]]; then
        echo -e "${RED}错误: 域名不能为空！${PLAIN}"
        return 1
    fi

    echo -e "正在调用 acme.sh 为 ${CYAN}${req_domain}${PLAIN} 签发 Let's Encrypt 证书..."
    "$ACME_BIN" --set-default-ca --server letsencrypt >/dev/null 2>&1 || true

    if "$ACME_BIN" --issue -d "$req_domain" --standalone --keylength ec-256; then
        echo -e "${GREEN}Let's Encrypt 权威证书签发成功！${PLAIN}"
        
        # 直接配置，实时生效
        mkdir -p /etc/aero
        if [[ -f "$JSON_CONFIG" ]]; then
            python3 -c "
import json
try:
    with open('$JSON_CONFIG', 'r') as f:
        data = json.load(f)
except Exception:
    data = {}
data['domain'] = '$req_domain'
with open('$JSON_CONFIG', 'w') as f:
    json.dump(data, f, indent=2)
" 2>/dev/null || sed -i "s/\"domain\": *\"[^\"]*\"/\"domain\": \"$req_domain\"/g" "$JSON_CONFIG"
        else
            cat > "$JSON_CONFIG" <<EOF
{
  "listen": ":443",
  "domain": "$req_domain",
  "data_dir": "/var/lib/aero"
}
EOF
            chmod 600 "$JSON_CONFIG"
        fi

        echo -e "正在向 AERO 服务端触发平滑热重载 (Live Reload)..."
        systemctl reload aero-edge 2>/dev/null || systemctl restart aero-edge 2>/dev/null || true
        echo -e "${GREEN}证书已直接配置并实时生效！${PLAIN}"
        cmd_cert
    else
        echo -e "${RED}证书签发失败！请检查 80 端口是否被占用，以及 DNS 解析是否已正确生效！${PLAIN}"
        return 1
    fi
}

cmd_bbr() {
    check_root
    echo -e "${CYAN}====================================================${PLAIN}"
    echo -e "${BOLD}           内核 BBR 拥塞控制与参数调优              ${PLAIN}"
    echo -e "${CYAN}====================================================${PLAIN}"
    CC=$(cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null || echo "unknown")
    echo -e " 当前拥塞算法:   ${GREEN}${CC}${PLAIN}"
    QDISC=$(cat /proc/sys/net/core/default_qdisc 2>/dev/null || echo "unknown")
    echo -e " 队列调度器:     ${GREEN}${QDISC}${PLAIN}"
    echo -e "${CYAN}----------------------------------------------------${PLAIN}"
    
    if [[ "$CC" != "bbr" ]]; then
        read -r -p "是否立即开启 BBR 拥塞控制与 16MB 缓冲区优化? [Y/n]: " do_tune
        if [[ ! "$do_tune" =~ ^[nN]$ ]]; then
            modprobe tcp_bbr 2>/dev/null || true
            sysctl -w net.core.default_qdisc=fq 2>/dev/null || true
            sysctl -w net.ipv4.tcp_congestion_control=bbr 2>/dev/null || true
            sysctl -w net.core.rmem_max=16777216 2>/dev/null || true
            sysctl -w net.core.wmem_max=16777216 2>/dev/null || true
            echo -e "${GREEN}BBR 拥塞控制与内核缓冲区优化已完成！${PLAIN}"
        fi
    else
        echo -e "${GREEN}BBR 已经处于激活运行状态，无需重复配置。${PLAIN}"
    fi
    echo -e "${CYAN}====================================================${PLAIN}"
}

cmd_net() {
    echo -e "${CYAN}====================================================${PLAIN}"
    echo -e "${BOLD}         虚拟网卡 (TUN) 与防火墙 NAT 状态           ${PLAIN}"
    echo -e "${CYAN}====================================================${PLAIN}"
    if ip link show aero-tun0 >/dev/null 2>&1; then
        echo -e " 网卡设备:       ${GREEN}aero-tun0 (UP)${PLAIN}"
        ip addr show aero-tun0 | grep -E "inet |inet6 " | awk '{print " 绑定 IP:         " $2}'
        echo -e " MTU 设定:       1360"
    else
        echo -e " 网卡设备:       ${YELLOW}aero-tun0 未就绪 (将在启动服务时自闭环创建)${PLAIN}"
    fi
    echo -e "${CYAN}----------------------------------------------------${PLAIN}"
    echo -e " IPv4 转发:       $(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo 0)"
    echo -e " 防火墙 MASQUERADE 规则数量:"
    iptables -t nat -S POSTROUTING 2>/dev/null | grep -c "aero_edge_default" | awk '{print "   IPv4 Tagged: " $1}' || true
    ip6tables -t nat -S POSTROUTING 2>/dev/null | grep -c "aero_edge_default" | awk '{print "   IPv6 Tagged: " $1}' || true
    echo -e "${CYAN}====================================================${PLAIN}"
}

cmd_geodata() {
    load_config
    echo -e "${CYAN}====================================================${PLAIN}"
    echo -e "${BOLD}              GeoData 直连分流规则库                ${PLAIN}"
    echo -e "${CYAN}====================================================${PLAIN}"
    GEO_FILE="${DATA_DIR}/geodata_direct.txt"
    if [[ -f "$GEO_FILE" ]]; then
        LINES=$(wc -l < "$GEO_FILE" 2>/dev/null || echo "0")
        MTIME=$(stat -c %y "$GEO_FILE" 2>/dev/null || stat -f "%Sm" "$GEO_FILE" 2>/dev/null || echo "未知")
        echo -e " 规则库路径:     ${GEO_FILE}"
        echo -e " 规则条目数:     ${GREEN}${LINES} 条${PLAIN}"
        echo -e " 最后更新时间:   ${MTIME}"
    else
        echo -e " 规则库状态:     ${YELLOW}尚未下载本地缓存 (由服务端自动同步)${PLAIN}"
    fi
    echo -e "${CYAN}----------------------------------------------------${PLAIN}"
    read -r -p "是否立即向服务端触发一次规则库上游同步? [y/N]: " do_sync
    if [[ "$do_sync" =~ ^[yY]$ ]]; then
        echo -e "${CYAN}正在同步 GeoData 规则库...${PLAIN}"
        curl -fsS -X POST "http://127.0.0.1:${PRIMARY_PORT}/admin/api/geodata/update?key=${ADMIN_KEY}" 2>/dev/null || \
        curl -fsS "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/direct-list.txt" -o "$GEO_FILE" 2>/dev/null || true
        echo -e "${GREEN}同步请求已发送！${PLAIN}"
    fi
    echo -e "${CYAN}====================================================${PLAIN}"
}

cmd_warp() {
    echo -e "${CYAN}====================================================${PLAIN}"
    echo -e "${BOLD}           Cloudflare WARP 出口代理状态             ${PLAIN}"
    echo -e "${CYAN}====================================================${PLAIN}"
    if command -v warp-cli >/dev/null 2>&1; then
        echo -e " WARP CLI:       ${GREEN}已安装${PLAIN}"
        warp-cli status 2>/dev/null | head -n 5 || true
    elif ss -tuln 2>/dev/null | grep -q ":40000\b"; then
        echo -e " WARP 状态:      ${GREEN}SOCKS5 代理运行在 :40000 (已激活)${PLAIN}"
    else
        echo -e " WARP 状态:      ${YELLOW}未检测到活动的 WARP SOCKS5 (服务端正常直连出站)${PLAIN}"
    fi
    echo -e "${CYAN}====================================================${PLAIN}"
}

cmd_update() {
    check_root
    load_config
    echo -e "${CYAN}====================================================${PLAIN}"
    echo -e " 正在在线更新 AERO Edge 服务端至最新版本..."
    echo -e "${CYAN}====================================================${PLAIN}"
    if [[ -z "$DOMAIN" ]]; then
        read -r -p "请输入节点绑定的域名: " DOMAIN
    fi
    curl -fsSL "$INSTALL_SCRIPT_URL" | bash -s -- -d "$DOMAIN" ${ADMIN_KEY:+-k "$ADMIN_KEY"} ${TOKEN:+-t "$TOKEN"}
    echo -e "${GREEN}AERO Edge 节点更新流程完成！${PLAIN}"
}

cmd_uninstall() {
    check_root
    echo -e "${RED}====================================================${PLAIN}"
    echo -e "${RED}${BOLD}             警告: 即将卸载 AERO Edge 节点         ${PLAIN}"
    echo -e "${RED}====================================================${PLAIN}"
    read -r -p "是否同时彻底清除全部数据目录与配置 (/var/lib/aero, /etc/aero)? [Y/n]: " confirm_purge
    
    PURGE_FLAG="--purge"
    if [[ "$confirm_purge" =~ ^[nN]$ ]]; then
        PURGE_FLAG=""
    fi
    
    if [[ -f "/usr/local/bin/edge-uninstall.sh" ]]; then
        bash /usr/local/bin/edge-uninstall.sh $PURGE_FLAG
    else
        curl -fsSL "$UNINSTALL_SCRIPT_URL" | bash -s -- $PURGE_FLAG
    fi
    echo -e "${GREEN}AERO Edge 卸载完成，宿主机环境已彻底还原。${PLAIN}"
    exit 0
}

