#!/usr/bin/env bash
# AERO Edge 节点运维命令 v1.4.1
#
# 安装只安装服务端（edge-install.sh）；域名、证书、WARP、端口、管理密钥都在本机用本命令完成：
# 修改经 `aero-edge config` 校验后由 edge 写入自己的配置，`aero-edge check` 全部通过后才（重新）启动服务。
# 可选软件（acme.sh、Cloudflare WARP）只在用户确认后安装，只用官方来源；edge 只使用、不安装它们。
set -euo pipefail

EDGE=/usr/local/bin/aero-edge
CONFIG=/etc/aero/edge.json
DATA=/var/lib/aero
ACME_HOME=/root/.acme.sh
ACME=$ACME_HOME/acme.sh
WARP_STATE=$DATA/warp-installed-packages   # aero 安装 WARP 时新增的软件包（卸载时只移除这些）
WARP_LIST=/etc/apt/sources.list.d/cloudflare-client.list
WARP_KEY=/usr/share/keyrings/cloudflare-warp-archive-keyring.asc
UNINSTALLER=/usr/local/lib/aero/edge-uninstall.sh

G="\033[32m"; Y="\033[33m"; R="\033[31m"; C="\033[36m"; N="\033[0m"
ok()   { echo -e "${G}$*${N}"; }
warn() { echo -e "${Y}$*${N}"; }
err()  { echo -e "${R}$*${N}" >&2; }
need_root() { [[ $EUID -eq 0 ]] || { err "需要 root 权限"; exit 1; }; }
# 非交互（自动化）：AERO_YES=1 视为全部确认；AERO_DOMAIN、AERO_EMAIL 提供输入。
confirm() { [[ "${AERO_YES:-}" == 1 ]] && { echo "$1 [y/N]: y (AERO_YES)"; return 0; }; local a; read -r -p "$1 [y/N]: " a </dev/tty || a=""; [[ "$a" =~ ^[yY]$ ]]; }
ask() { local v="${!2:-}"; [[ -n "$v" ]] || read -r -p "$1" v </dev/tty || true; echo "$v"; }
cfg_get() { "$EDGE" config -config "$CONFIG" get "$1" 2>/dev/null || true; }
cfg_set() { "$EDGE" config -config "$CONFIG" set "$1" "$2"; }

# check_and_restart：检查全部通过才（重新）启动服务并等待就绪；否则不动服务。
check_and_restart() {
  echo -e "${C}== 检查${N}"
  if ! "$EDGE" check -config "$CONFIG"; then
    err "检查未通过，服务未重启。修复上面的 FAIL 项后执行: aero restart"
    return 1
  fi
  systemctl enable aero-edge >/dev/null 2>&1
  systemctl restart aero-edge
  local i
  for i in $(seq 1 20); do
    if systemctl is-active --quiet aero-edge && journalctl -u aero-edge --since "-30s" --no-pager 2>/dev/null | grep -q "Server started"; then
      ok "服务已启动：$(journalctl -u aero-edge --since "-30s" --no-pager | grep -o 'Server started on [^ ]*' | tail -1)"
      return 0
    fi
    sleep 1
  done
  err "服务未在 20 秒内就绪，最近日志："
  journalctl -u aero-edge -n 20 --no-pager
  return 1
}

cmd_status() {
  echo -e "${C}== 服务${N}"
  echo " 状态: $(systemctl is-active aero-edge 2>/dev/null || true)   版本: $("$EDGE" -version 2>/dev/null | awk '{print $2}')"
  echo -e "${C}== 检查${N}"
  "$EDGE" check -config "$CONFIG" || true
  echo -e "${C}== 监听${N}"
  ss -lntup 2>/dev/null | grep aero-edge | awk '{print " "$1, $5}' | sort -u || true
}

cmd_domain() {
  need_root
  local d="${1:-}"
  [[ -n "$d" ]] || d=$(ask "节点域名（已在 DNS 指向本机，Cloudflare 须灰云）: " AERO_DOMAIN)
  cfg_set domain "$d" && ok "域名已设置为 $(cfg_get domain)"
}

# acme.sh 默认目录：ECC 证书在 /root/.acme.sh/<域名>_ecc/，edge 只读发现，续期后自动热加载。
cmd_cert() {
  need_root
  local d; d=$(cfg_get domain)
  [[ -n "$d" ]] || { err "先设置域名: aero domain <域名>"; return 1; }
  if "$EDGE" check-cert -domain "$d" | grep -qx 'CERT_FOUND=yes'; then
    ok "已有覆盖 $d 的有效证书："; "$EDGE" check-cert -domain "$d" | grep -E 'CERT_FILE|CERT_NOT_AFTER'
    return 0
  fi
  warn "没有覆盖 $d 的有效证书。"
  if [[ ! -x "$ACME" ]]; then
    confirm "是否安装官方 acme.sh（https://get.acme.sh，会添加 acme.sh 自己的自动续期 cron）?" || { warn "已跳过。可自行签发到 acme.sh/certbot 默认目录后再执行 aero check"; return 1; }
    local email; email=$(ask "用于 Let's Encrypt 账户的邮箱: " AERO_EMAIL)
    [[ "$email" == *@*.* ]] || { err "邮箱无效"; return 1; }
    curl -fsSL https://get.acme.sh | sh -s email="$email" || { err "acme.sh 安装失败"; return 1; }
  fi
  confirm "用 80 端口（standalone）为 $d 签发 Let's Encrypt 证书?" || return 1
  if ss -lnt 2>/dev/null | awk '{print $4}' | grep -qE ':80$'; then
    err "80 端口已被其他程序占用，standalone 无法签发；AERO 不会停止其他服务。请改用 DNS 方式自行签发。"
    return 1
  fi
  "$ACME" --issue --standalone -d "$d" --keylength ec-256 --server letsencrypt || { err "签发失败：检查 DNS 是否指向本机、80 端口是否可从公网访问"; return 1; }
  ok "证书已签发到 $ACME_HOME/${d}_ecc/（默认目录，edge 自动发现）"
}

warp_status() {
  if command -v warp-cli >/dev/null; then
    echo " WARP 客户端: 已安装（$(warp-cli --version 2>/dev/null)）"
    warp-cli --accept-tos status 2>/dev/null | head -2 | sed 's/^/ /'
  else
    echo " WARP 客户端: 未安装"
  fi
  echo " edge 使用 WARP: $(cfg_get warp)（off=不用，ai=仅 AI 场景，all=全部流量）"
}

warp_install() {
  need_root
  if command -v warp-cli >/dev/null; then ok "WARP 已安装"; return 0; fi
  confirm "从 Cloudflare 官方源 pkg.cloudflareclient.com 安装 WARP 客户端（代理模式，只监听 127.0.0.1:40000，不改系统路由）?" || return 1
  . /etc/os-release
  local before; before=$(dpkg-query -W -f='${Package}\n' | sort)
  curl -fsSL https://pkg.cloudflareclient.com/pubkey.gpg -o "$WARP_KEY"
  echo "deb [signed-by=$WARP_KEY] https://pkg.cloudflareclient.com/ ${VERSION_CODENAME} main" > "$WARP_LIST"
  if ! apt-get update >/dev/null \
     || ! DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends cloudflare-warp; then
    err "安装失败（官方源可能尚不支持 ${VERSION_CODENAME}）；已撤销软件源"
    rm -f "$WARP_LIST" "$WARP_KEY"
    return 1
  fi
  mkdir -p "$DATA"
  comm -13 <(echo "$before") <(dpkg-query -W -f='${Package}\n' | sort) > "$WARP_STATE"
  warp-cli --accept-tos registration new >/dev/null
  warp-cli --accept-tos mode proxy >/dev/null
  warp-cli --accept-tos proxy port 40000 >/dev/null
  warp-cli --accept-tos connect >/dev/null
  sleep 5
  warp-cli --accept-tos status | head -2
  ok "WARP 已安装（代理模式）。启用：aero warp ai 或 aero warp all"
}

warp_uninstall() {
  need_root
  command -v warp-cli >/dev/null || { ok "WARP 未安装"; return 0; }
  confirm "卸载 WARP（只移除 aero 安装时新增的软件包与官方源）?" || return 1
  if [[ "$(cfg_get warp)" != off ]]; then cfg_set warp off; check_and_restart || true; fi
  warp-cli --accept-tos disconnect >/dev/null 2>&1 || true
  if [[ -s "$WARP_STATE" ]]; then
    DEBIAN_FRONTEND=noninteractive apt-get purge -y $(cat "$WARP_STATE")
  else
    DEBIAN_FRONTEND=noninteractive apt-get purge -y cloudflare-warp
  fi
  rm -f "$WARP_LIST" "$WARP_KEY" "$WARP_STATE"
  ok "WARP 已卸载"
}

cmd_warp() {
  case "${1:-status}" in
    status) warp_status ;;
    install) warp_install ;;
    uninstall) warp_uninstall ;;
    off|ai|all) need_root; cfg_set warp "$1" && ok "edge 使用 WARP: $1"; check_and_restart ;;
    *) err "用法: aero warp [status|install|uninstall|off|ai|all]"; return 2 ;;
  esac
}

cmd_port() {
  need_root
  local p="${1:-}"
  [[ -n "$p" ]] || read -r -p "主端口（默认 443；被占用时 edge 自动轮试候选端口）: " p </dev/tty
  cfg_set listen "${p:-443}" && ok "主端口: $(cfg_get listen)"
}

cmd_key() {
  need_root
  local k; k=$(cfg_set admin_key random)
  ok "新管理密钥（只显示这一次，请保存）："
  echo "  $k"
  warn "已登记该节点的中台需要同步新密钥。"
}

cmd_setup() {
  need_root
  echo -e "${C}== 1/5 域名${N}"
  local d; d=$(cfg_get domain)
  if [[ -z "$d" || -n "${AERO_DOMAIN:-}" && "${AERO_DOMAIN:-}" != "$d" ]]; then cmd_domain; else ok "域名: $d（修改: aero domain <域名>）"; fi
  echo -e "${C}== 2/5 证书${N}"
  cmd_cert || true
  echo -e "${C}== 3/5 WARP（可选）${N}"
  if command -v warp-cli >/dev/null || confirm "是否安装官方 WARP（用于保护出口 IP，可稍后用 aero warp install）?"; then
    warp_install || true
    if command -v warp-cli >/dev/null && confirm "让 edge 使用 WARP（仅 AI 场景）?"; then cfg_set warp ai; fi
  fi
  echo -e "${C}== 4/5 端口${N}"
  [[ -n "$(cfg_get listen)" ]] || cfg_set listen 443
  echo " 主端口 $(cfg_get listen)（被其他程序占用时自动轮试 2083/2087/8443/...）"
  echo -e "${C}== 5/5 管理密钥${N}"
  local k; k=$(cfg_get admin_key)
  if [[ ${#k} -lt 32 ]]; then cmd_key; else ok "已有管理密钥（${#k} 位）"; fi
  check_and_restart
}

cmd_info() {
  need_root
  local d p k suffix
  d=$(cfg_get domain); p=$(cfg_get listen); p=${p#:}; k=$(cfg_get admin_key)
  suffix=""; [[ -n "$p" && "$p" != 443 ]] && suffix=":$p"
  echo " 节点: https://${d:-<未设置域名>}${suffix}"
  echo " Web 控制台: https://${d}${suffix}/console?key=${k}"
  echo " 管理员订阅: 在 Web 控制台查看"
}

cmd_net() {
  ip -br addr show aero-tun0 2>/dev/null || echo " aero-tun0 不存在（服务未运行）"
  echo " ip_forward: $(cat /proc/sys/net/ipv4/ip_forward)"
  if command -v nft >/dev/null && nft list table inet aero_edge >/dev/null 2>&1; then
    echo " 规则: nft 表 inet aero_edge"
  elif command -v iptables >/dev/null; then
    echo " 规则: iptables 标记 aero_edge_default $( (iptables-save; ip6tables-save) 2>/dev/null | grep -c aero_edge_default) 条"
  fi
}

cmd_update() {
  need_root
  local v="${1:-}"
  [[ -n "$v" ]] || v=$(curl -fsSL https://api.github.com/repos/jackybig999/aero/releases/latest | grep -o '"tag_name": *"v[^"]*"' | grep -o '[0-9][0-9.]*')
  [[ -n "$v" ]] || { err "无法获取最新版本"; return 1; }
  local tmp; tmp=$(mktemp)
  curl -fsSL -o "$tmp" "https://github.com/jackybig999/aero/releases/download/v$v/edge-install.sh"
  AERO_VERSION="$v" bash "$tmp"; rm -f "$tmp"
}

cmd_uninstall() {
  need_root
  confirm "卸载 AERO Edge?" || return 0
  if command -v warp-cli >/dev/null && [[ -s "$WARP_STATE" ]] && confirm "同时卸载由 aero 安装的 WARP?"; then warp_uninstall || true; fi
  if [[ -x "$ACME" ]] && confirm "同时卸载 acme.sh 及其证书（/root/.acme.sh）?"; then
    "$ACME" --uninstall >/dev/null 2>&1 || true; rm -rf "$ACME_HOME"
  fi
  local purge=""; confirm "删除配置与数据（/etc/aero、/var/lib/aero）?" && purge=--purge
  bash "$UNINSTALLER" $purge
}

usage() {
  cat <<'EOF'
用法: aero <命令>
  setup              引导完成域名、证书、可选 WARP、端口、管理密钥，检查通过后启动服务
  status             服务状态与检查结果
  check              检查（全部通过才可重启）
  domain [域名]      设置节点域名
  cert               检查证书；没有时可选安装 acme.sh 并签发（默认目录）
  warp [status|install|uninstall|off|ai|all]
                     WARP 官方客户端（可选插件）与 edge 使用开关
  port [端口]        主端口（默认 443，被占用时自动轮试）
  key                生成新的管理密钥
  start|stop|restart|log
  info               节点地址与 Web 控制台链接
  net                TUN 与转发规则状态
  update [版本]      升级服务端
  uninstall          卸载（WARP、acme.sh 逐项询问）
修改配置后执行 aero restart（先检查，通过才重启）。
EOF
}

[[ -x "$EDGE" ]] || { err "未安装 aero-edge"; exit 1; }
case "${1:-help}" in
  setup) cmd_setup ;;
  status) cmd_status ;;
  check) "$EDGE" check -config "$CONFIG" ;;
  domain) cmd_domain "${2:-}" ;;
  cert) cmd_cert ;;
  warp) cmd_warp "${2:-status}" ;;
  port) cmd_port "${2:-}" ;;
  key) cmd_key ;;
  start|restart) need_root; check_and_restart ;;
  stop) need_root; systemctl stop aero-edge && ok "已停止" ;;
  log|logs) journalctl -u aero-edge -f ;;
  info) cmd_info ;;
  net) cmd_net ;;
  update) cmd_update "${2:-}" ;;
  uninstall) cmd_uninstall ;;
  *) usage ;;
esac
