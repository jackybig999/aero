{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aero.invalid/api/subscription.schema.json",
  "title": "AERO subscription document (C5, aero/3.0)",
  "type": "object",
  "required": [
    "version",
    "servers"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "aero/3.0"
    },
    "userId": {
      "type": "string"
    },
    "expireAt": {
      "type": "integer",
      "minimum": 0
    },
    "trafficLimitBytes": {
      "type": "integer",
      "minimum": 0
    },
    "trafficUsedBytes": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0
    },
    "optimization": {
      "type": "object"
    },
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/server"
      }
    },
    "switchStatus": {
      "enum": [
        "on",
        "off"
      ],
      "description": "off 表示订阅被停用（客户端视为失效）"
    }
  },
  "$defs": {
    "server": {
      "type": "object",
      "required": [
        "name",
        "host",
        "token",
        "sni",
        "protocol"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string"
        },
        "ip": {
          "type": "string"
        },
        "token": {
          "type": "string",
          "minLength": 1
        },
        "sni": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "enum": [
            "connect-ip"
          ]
        },
        "alt_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "pin_spki": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "line_type": {
          "type": "string"
        },
        "isp_affinity": {
          "type": "string"
        },
        "ech": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "purityScore": {
          "type": "integer"
        },
        "aiBlocked": {
          "type": "boolean"
        },
        "warp_active": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
